# API-Football odds endpoint (separate plan — optional fallback)
# Only needed if The Odds API doesn't cover Liga MX
API_FOOTBALL_ODDS_KEY=

# Anthropic (for LLM explanation generator)
ANTHROPIC_API_KEY=
